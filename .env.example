# Copy this file to .env and fill in your keys.
ANTHROPIC_API_KEY=your-key-here
DEEPGRAM_API_KEY=your-deepgram-key-here

# Postgres connection string from Neon (Dashboard, then Connect).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs login cookies. At least 32 random characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# The admin account is created from these on first run (password: 10+ characters).
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-strong-password

# Optional
# SESSION_MAX_MINUTES=60
# NODE_ENV=production        (only when served over HTTPS; makes cookies Secure)
# PORT=3000
# HOST=127.0.0.1
# MODEL_SHORT=claude-haiku-4-5-20251001
# MODEL_LONG=claude-sonnet-5
